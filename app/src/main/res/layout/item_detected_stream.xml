<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_item"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Format Badge + Timestamp + Domain -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFormatBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#33FF5722"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#FF5722"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="HLS .m3u8" />

        <TextView
            android:id="@+id/tvStreamDomain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp"
            tools:text="bhalocast.com" />

        <TextView
            android:id="@+id/tvTimeAgo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hint"
            android:textSize="10.5sp"
            tools:text="12:34:56" />
    </LinearLayout>

    <!-- Stream URL (Full text) -->
    <TextView
        android:id="@+id/tvStreamUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        tools:text="https://mz01.bhalocast.com:7060/hls/sony1c.m3u8?md5=xxx&amp;expires=1791012812" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- Send to Supabase Button -->
        <TextView
            android:id="@+id/btnSendToSupabase"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_script"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="📤 Supabase"
            android:textColor="@color/primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Copy cURL button -->
        <TextView
            android:id="@+id/btnCopyCurl"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="🔗 cURL"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp" />

        <!-- Copy URL button -->
        <TextView
            android:id="@+id/btnCopyUrl"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="📋 Copy"
            android:textColor="#000000"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
